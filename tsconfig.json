{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist"
    ],
    "compilerOptions": {
        "paths": {
            "#src/*": [
                "./src/*"
            ],
            "#components/*": [
                "./src/components/*"
            ],
            "#assets/*": [
                "./src/assets/*"
            ],
            "#layouts/*": [
                "./src/layouts/*"
            ],
            "#public/*": [
                "./public/*"
            ]
        }
    }
}