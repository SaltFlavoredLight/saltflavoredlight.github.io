---
import "../styles/main.css";
import "../styles/themes.css";
import "../styles/core.css";

import SiteMiniHeader from "../componets/header/SiteSPHeader.astro";

const {
    pageTitle,
    themeColor = "rose",
    darkMode = false,
} = Astro.props;

// ready the factroy:
let bodyClass = "";

bodyClass += `theme-${themeColor}`;

if (darkMode) {
    bodyClass += ` dark-mode`;
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle} - Rayzhi</title>
    </head>
    <body class={bodyClass}>
        <SiteMiniHeader />
        <main>
            <h1>{pageTitle}</h1>
            <slot />
        </main>
    </body>
</html>

<style>
    
main {
    padding: var(--spacing-md) var(--spacing-lg);
    margin: 0 auto;
    max-width: 1000px;
}

</style>