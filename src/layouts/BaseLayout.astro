---
import "#src/styles/main.css";
import "#src/styles/themes.css";

import SiteHeader from "#src/components/header/SiteHeader.astro";
import SiteFooter from "#src/components/footer/SiteFooter.astro";

// All 9 mathematical combinations of Header & Footer states
type SiteLayout =
    | "full"
    | "landing"
    | "headerOnly"
    | "footerOnly"
    | "mix"
    | "fullLanding"
    | "none"
    | "landingHeaderOnly"
    | "landingFooterOnly";

interface Props {
    title: string;
    themeColor?: string;
    darkMode?: boolean;
    description?: string;
    slug: string;
    imagePath?: string;
    pageLayout?: SiteLayout;
}

const {
    title,
    themeColor = "rose",
    darkMode = false,
    description = "A Website About Ray. Hi! This is Ray and I love to share something!",
    slug = "/", // Slug input (e.g. "/about" or "")
    imagePath = "/cover.png", // Image path relative to your domain
    pageLayout = "full",
} = Astro.props;

// Get domain from Astro config (with fallback placeholder)
const domain = Astro.site ? Astro.site.href : "https://raystudio.net";

// Combine domain with slug and image path
const canonicalURL = new URL(slug, "https://www.raystudio.net").href;
const image = new URL(imagePath, domain).href;

// Standard variables
const keywords = "Ray, Website, Personal";
const iconPath = "/favicon.png";
const iconURL = new URL(iconPath, domain).href;

// Body theme class factory
let bodyClass = `theme-${themeColor}`;
if (darkMode) {
    bodyClass += ` dark-mode`;
}

// State mapping for Header and Footer: 'full', 'landing', or 'none'
let headerState: "full" | "landing" | "none" = "full";
let footerState: "full" | "landing" | "none" = "full";

switch (pageLayout) {
    case "full":
        headerState = "full";
        footerState = "full";
        break;
    case "landing":
        headerState = "landing";
        footerState = "landing";
        break;
    case "headerOnly":
        headerState = "full";
        footerState = "none";
        break;
    case "footerOnly":
        headerState = "none";
        footerState = "full";
        break;
    case "mix":
        headerState = "full";
        footerState = "landing";
        break;
    case "fullLanding":
        headerState = "landing";
        footerState = "full";
        break;
    case "none":
        headerState = "none";
        footerState = "none";
        break;
    case "landingHeaderOnly":
        headerState = "landing";
        footerState = "none";
        break;
    case "landingFooterOnly":
        headerState = "none";
        footerState = "landing";
        break;
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Favicon / Site Icon -->
        <link rel="icon" href={iconURL} />

        <!-- SEO Meta Tags -->
        <title>{title} | Rayzhi</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Social Sharing SEO -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:url" content={canonicalURL} />
    </head>
    <body class={bodyClass}>
        <!-- Header Rendering Logic -->
        {
            headerState === "full" && (
                <SiteHeader landing={false} singlePage={pageLayout} />
            )
        }
        {
            headerState === "landing" && (
                <SiteHeader landing={true} singlePage={pageLayout} />
            )
        }

        <main>
            <slot />
        </main>

        <!-- Footer Rendering Logic -->
        {
            footerState === "full" && (
                <SiteFooter landing={false} singlePage={pageLayout} />
            )
        }
        {
            footerState === "landing" && (
                <SiteFooter landing={true} singlePage={pageLayout} />
            )
        }
    </body>
</html>

<style>
    main {
        padding: var(--spacing-md) var(--spacing-lg);
        margin: 0 auto;
        max-width: var(--page-max-width);
    }

    @media (max-width: 600px) {
        main {
            padding: calc((var(--spacing-md) + var(--spacing-lg))/2);
        }
    }
</style>
