---
import "../styles/main.css";
import "../styles/themes.css";
import "../styles/core.css";

import BaseLayout from "./BaseLayout.astro";

export type SiteLayout = 
    | 'full' 
    | 'landing' 
    | 'headerOnly' 
    | 'footerOnly' 
    | 'mix' 
    | 'fullLanding' 
    | 'none'
    | 'landingHeaderOnly'
    | 'landingFooterOnly';

export interface Props {
    title: string;
    themeColor?: string;
    darkMode?: boolean;
    description?: string;
    slug?: string;
    imagePath?: string;
    pageLayout?: SiteLayout;
}

const {
    title,
    themeColor = "rose",
    darkMode = false,
    description = "A Website About Ray. Hi! This is Ray and I love to share something!",
    slug = "/", 
    imagePath = "/cover.png",
    pageLayout = "full"
} = Astro.props;
---

<BaseLayout
    title={title}
    themeColor={themeColor}
    darkMode={darkMode}
    description={description}
    slug={slug}
    imagePath={imagePath}
    pageLayout={pageLayout}
>
    <h1>{title}</h1>
    <slot />
</BaseLayout>