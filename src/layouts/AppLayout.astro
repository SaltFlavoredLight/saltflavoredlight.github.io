---
import BaseLayout from "./BaseLayout.astro";

type SiteLayout =
    | "full"
    | "landing"
    | "headerOnly"
    | "footerOnly"
    | "mix"
    | "fullLanding"
    | "none"
    | "landingHeaderOnly"
    | "landingFooterOnly";

interface Props {
    title?: string;
    themeColor?: string;
    darkMode?: boolean;
    description?: string;
    slug?: string;
    imagePath?: string;
    pageLayout?: SiteLayout;
    frontmatter?: Props;
}

// Extract props from frontmatter (when loaded via MDX layout:) 
// or directly from Astro.props (when loaded via Astro component)
const content = Astro.props.frontmatter || Astro.props;

const {
    title = "Untitled Page",
    themeColor = "rose",
    darkMode = false,
    description = "A Website About Ray. Hi! This is Ray and I love to share something!",
    slug = "/",
    imagePath = "/cover.png",
    pageLayout = "full",
} = content;
---

<BaseLayout
    title={title}
    themeColor={themeColor}
    darkMode={darkMode}
    description={description}
    slug={slug}
    imagePath={imagePath}
    pageLayout={pageLayout}
>
    <h1 class="text-center">{title}</h1>
    <slot />
</BaseLayout>