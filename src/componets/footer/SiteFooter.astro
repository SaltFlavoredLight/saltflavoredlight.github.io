---
import "../../styles/main.css";
import "../../styles/themes.css";


import FooterTop from "./FooterTop.astro";
import FooterNotes from "./FooterNotes.astro";

interface Props {
    landing?: boolean;
    singlePage?: string; // Or use your specific SiteLayout union type here too
}

const { landing = false } = Astro.props;
---

<footer>
    { !landing && <FooterTop /> }
    <hr />
    <FooterNotes />
</footer>

<style>
    footer {
        width: 100%;
        min-height: 50px;

        background: var(--theme-primary);
        color: var(--bg-primary);

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        box-shadow: 0 0 20px var(--text-primary);
    }
</style>