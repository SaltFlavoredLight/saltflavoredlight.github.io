---
export interface Props {
    title: string;
    href?: string;
}

const { title, href = "#" } = Astro.props;
---

<li class="link-card">
    <a href={href}>
        <h2>
            {title}
            <span>&rarr;</span>
        </h2>
        <div class="card-body">
            <slot />
        </div>
    </a>
</li>

<style>
    .link-card {
        list-style: none;
        display: flex;
        padding: 1px;
        background-color: var(--theme-card-bg, #ffffff);
        background-image: none;
        background-size: 400%;
        border-radius: 7px;
        border: 1px solid var(--theme-border, #eaeaea);
        transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .link-card > a {
        width: 100%;
        text-decoration: none;
        padding: 1.5rem;
        border-radius: 6px;
        color: var(--theme-text, #111);
        opacity: 0.8;
    }

    h2 {
        margin: 0;
        font-size: 1.25rem;
        transition: color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-body {
        margin-top: 0.5rem;
        color: var(--theme-text-muted, #555);
    }

    .link-card:is(:hover, :focus-within) {
        border-color: var(--theme-accent, #0051ff);
    }

    .link-card:is(:hover, :focus-within) h2 {
        color: var(--theme-accent, #0051ff);
    }
</style>