---
import "#src/styles/main.css";
import "#src/styles/themes.css";

import Button from "#components/element/Button.astro";
---

<div class="weight-customizer" id="weight-customizer" hidden>
    <section
        class="customizer-card"
        aria-labelledby="customizer-title"
        aria-describedby="customizer-help"
        role="dialog"
        aria-modal="true"
    >
        <Button
            class="close-button"
            id="customizer-close"
            type="button"
            aria-label="Close customization"
        >
            ×
        </Button>
        <p class="eyebrow">A little hidden extra</p>
        <h2 id="customizer-title">Make it yours</h2>
        <p id="customizer-help">
            Choose a theme and accent color. Your choice is saved in a cookie
            for one week.
        </p>

        <fieldset class="theme-options">
            <legend>Choose a theme</legend>
            <Button
                class="theme-choice"
                type="button"
                data-theme="sunrise"
                aria-pressed="true"
            >
                <span class="theme-name">Sunrise</span>
                <span class="theme-reason">
                    Unlocked by finding the secret sequence.
                </span>
            </Button>
            <Button
                class="theme-choice"
                type="button"
                data-theme="ocean"
                aria-pressed="false"
            >
                <span class="theme-name">Ocean</span>
                <span class="theme-reason">
                    A calm, cool look for curious explorers.
                </span>
            </Button>
            <Button
                class="theme-choice"
                type="button"
                data-theme="midnight"
                aria-pressed="false"
            >
                <span class="theme-name">Midnight</span>
                <span class="theme-reason">
                    For those who like a little mystery.
                </span>
            </Button>
        </fieldset>

        <label class="color-field" for="accent-color">
            <span>Accent color</span>
            <input id="accent-color" type="color" value="#f28b62" />
        </label>
        <div class="preview" id="theme-preview" aria-live="polite">
            <span class="preview-dot"></span>
            <span id="preview-label">Sunrise theme</span>
        </div>
        <p class="expiry-message" id="expiry-message" aria-live="polite">
            Your selection will expire one week after you save it.
        </p>
        <div class="actions">
            <Button class="save-button" id="customizer-save" type="button">
                Save choice
            </Button>
            <Button class="cancel-button" id="customizer-cancel" type="button">
                Not now
            </Button>
        </div>
    </section>
</div>

<script>
    const overlay =
        document.querySelector<HTMLDivElement>("#weight-customizer");
    const closeButton =
        document.querySelector<HTMLButtonElement>("#customizer-close");
    const cancelButton =
        document.querySelector<HTMLButtonElement>("#customizer-cancel");
    const saveButton =
        document.querySelector<HTMLButtonElement>("#customizer-save");
    const colorInput =
        document.querySelector<HTMLInputElement>("#accent-color");
    const expiryMessage =
        document.querySelector<HTMLParagraphElement>("#expiry-message");
    const previewLabel =
        document.querySelector<HTMLSpanElement>("#preview-label");
    const themeButtons = [
        ...document.querySelectorAll<HTMLButtonElement>(".theme-choice"),
    ];
    const themeNames: Record<string, string> = {
        sunrise: "Sunrise",
        ocean: "Ocean",
        midnight: "Midnight",
    };
    let selectedTheme = "sunrise";
    let previousFocus: HTMLElement | null = null;
    const cookieName = "weight-customizer-choice";

    const openCustomizer = () => {
        if (!overlay) return;
        previousFocus =
            document.activeElement instanceof HTMLElement
                ? document.activeElement
                : null;
        overlay.hidden = false;
        closeButton?.focus();
    };

    const closeCustomizer = () => {
        if (!overlay) return;
        overlay.hidden = true;
        previousFocus?.focus();
    };

    const updatePreview = () => {
        const color = colorInput?.value ?? "#f28b62";
        const dot = overlay?.querySelector<HTMLElement>(".preview-dot");
        if (dot) dot.style.backgroundColor = color;
        if (previewLabel)
            previewLabel.textContent = `${themeNames[selectedTheme] ?? "Sunrise"} theme`;
    };

    themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
            selectedTheme = button.dataset.theme ?? "sunrise";
            themeButtons.forEach((choice) =>
                choice.setAttribute("aria-pressed", String(choice === button)),
            );
            updatePreview();
        });
    });
    colorInput?.addEventListener("input", updatePreview);
    closeButton?.addEventListener("click", closeCustomizer);
    cancelButton?.addEventListener("click", closeCustomizer);

    saveButton?.addEventListener("click", () => {
        const expires = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
        const choice = {
            theme: selectedTheme,
            color: colorInput?.value ?? "#f28b62",
        };
        document.cookie = `${cookieName}=${encodeURIComponent(JSON.stringify(choice))}; expires=${expires.toUTCString()}; max-age=604800; path=/; SameSite=Lax`;
        expiryMessage &&
            (expiryMessage.textContent = `Saved! Your choice expires ${expires.toLocaleString()}.`);
        closeCustomizer();
    });

    // The classic sequence: Up, Up, Down, Down, Right, Left, Right, Left, B, A.
    const secretSequence = [
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "b",
        "a",
    ];
    let sequencePosition = 0;
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && overlay && !overlay.hidden) {
            closeCustomizer();
            return;
        }
        const key =
            event.key.length === 1 ? event.key.toLowerCase() : event.key;
        if (key === secretSequence[sequencePosition]) {
            sequencePosition += 1;
            if (sequencePosition === secretSequence.length) {
                sequencePosition = 0;
                openCustomizer();
            }
        } else {
            sequencePosition = key === secretSequence[0] ? 1 : 0;
        }
    });

    overlay?.addEventListener("click", (event) => {
        if (event.target === overlay) closeCustomizer();
    });
    updatePreview();
</script>

<style>
    .weight-customizer[hidden] {
        display: none;
    }
    .weight-customizer {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        padding: 1.25rem;
        background: rgb(12 15 24 / 42%);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .customizer-card {
        position: relative;
        width: min(100%, 28rem);
        max-height: min(90vh, 46rem);
        overflow: auto;
        padding: 2rem;
        border: 1px solid rgb(255 255 255 / 55%);
        border-radius: 1.25rem;
        background: #fffdfb;
        color: #24232a;
        box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 24%);
        font: inherit;
    }
    .close-button {
        position: absolute;
        top: 0.8rem;
        right: 0.9rem;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font: inherit;
        font-size: 1.8rem;
        line-height: 1;
    }
    .eyebrow {
        margin: 0 0 0.35rem;
        color: #8d5140;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    h2 {
        margin: 0 2rem 0.5rem 0;
        font-size: 1.65rem;
    }
    #customizer-help {
        margin: 0 0 1.25rem;
        color: #5e5c64;
        line-height: 1.5;
    }
    .theme-options {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        border: 0;
    }
    .theme-options legend {
        margin-bottom: 0.55rem;
        font-weight: 700;
    }
    .theme-choice {
        display: grid;
        gap: 0.15rem;
        width: 100%;
        padding: 0.8rem 0.9rem;
        border: 1px solid #dedbe0;
        border-radius: 0.75rem;
        background: white;
        color: inherit;
        cursor: pointer;
        text-align: left;
    }
    .theme-choice[aria-pressed="true"] {
        border-color: #b55f45;
        box-shadow: 0 0 0 2px rgb(181 95 69 / 16%);
    }
    .theme-name {
        font-weight: 700;
    }
    .theme-reason {
        color: #69666f;
        font-size: 0.85rem;
    }
    .color-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1rem;
        font-weight: 700;
    }
    .color-field input {
        width: 3rem;
        height: 2.25rem;
        padding: 0.15rem;
        border: 1px solid #dedbe0;
        border-radius: 0.45rem;
        background: white;
        cursor: pointer;
    }
    .preview {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-top: 0.8rem;
        color: #55515b;
        font-size: 0.9rem;
    }
    .preview-dot {
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        background: #f28b62;
    }
    .expiry-message {
        min-height: 1.25em;
        margin: 0.8rem 0 0;
        color: #5e5c64;
        font-size: 0.85rem;
    }
    .actions {
        display: flex;
        gap: 0.65rem;
        margin-top: 1rem;
    }
    .actions button {
        min-height: 2.7rem;
        padding: 0.65rem 1rem;
        border: 1px solid transparent;
        border-radius: 0.65rem;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
    }
    .save-button {
        flex: 1;
        background: #29262d;
        color: white;
    }
    .cancel-button {
        border-color: #dedbe0 !important;
        background: transparent;
        color: #39363e;
    }
    button:focus-visible,
    input:focus-visible {
        outline: 3px solid #ba6a4f;
        outline-offset: 2px;
    }
    @media (max-width: 24rem) {
        .customizer-card {
            padding: 1.5rem;
        }
        .actions {
            flex-direction: column;
        }
    }
</style>
