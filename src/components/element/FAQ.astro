---
interface Props {
	title: string;
	theme?: 'light' | 'dark' | string;
	onHover?: boolean;
}

const {
	title,
	theme = 'light',
	onHover = false,
} = Astro.props;
---

<details
	class="faq__item"
	data-theme={theme}
	data-on-hover={onHover ? 'true' : undefined}
>
	<summary>{title}</summary>
	<div class="faq__answer">
		<slot />
	</div>
</details>

<script>
	const hoverItems = document.querySelectorAll<HTMLDetailsElement>(
		'.faq__item[data-on-hover="true"]'
	);

	hoverItems.forEach((item) => {
		item.addEventListener('mouseenter', () => {
			item.open = true;
		});
		item.addEventListener('mouseleave', () => {
			item.open = false;
		});
	});
</script>

<style>
	.faq__item {
		--item-bg: transparent;
		--item-text: inherit;
		--item-muted: var(--color-muted, #666);
		--item-border: var(--color-border, #ddd);
		--item-accent: var(--color-accent, #7657d5);

		background-color: var(--item-bg);
		color: var(--item-text);
		border-bottom: 1px solid var(--item-border);
	}

	.faq__item:first-child {
		border-top: 1px solid var(--item-border);
	}

	.faq__item[data-theme='dark'] {
		--item-bg: #141418;
		--item-text: #f5f5f7;
		--item-muted: #a1a1aa;
		--item-border: #27272a;
	}

	.faq__item summary {
		position: relative;
		padding: 1.25rem 2rem 1.25rem 0;
		font-weight: 600;
		line-height: 1.5;
		cursor: pointer;
		list-style: none;
	}

	.faq__item summary::-webkit-details-marker {
		display: none;
	}

	.faq__item summary::after {
		position: absolute;
		top: 50%;
		right: 0.25rem;
		content: '+';
		font-size: 1.4rem;
		transform: translateY(-50%);
	}

	.faq__item[open] summary::after {
		content: '−';
	}

	.faq__item summary:focus-visible {
		outline: 2px solid var(--item-accent);
		outline-offset: 4px;
	}

	.faq__answer {
		margin: -0.25rem 1.5rem 1.25rem 0;
		color: var(--item-muted);
		line-height: 1.7;
	}

	.faq__answer :global(p:first-child) {
		margin-top: 0;
	}

	.faq__answer :global(p:last-child) {
		margin-bottom: 0;
	}
</style>