---
interface Props {
    /** when blank, disabled, otherwise, the name appeared here will be applied to style, Option: color, move, both */
    hover?: "" | "color" | "move" | "both";

    /** this is theme for the card, default is light, where also have Dark, Border and Middle option */
    theme?: "" | "dark" | "border" | "middle" | "bold";

    /** true if you hate border */
    borderless?: "true" | "false" | Boolean;

    noBottomMargin?: boolean | "false" | "true";

    padding?: "" | "more" | "default" | "none" | "bottom";

    full?: Boolean | "true" | "false";
}

import "#src/styles/main.css";
import "#src/styles/themes.css";

const {
    hover = "",
    theme = "",
    borderless = "false",
    noBottomMargin = false,
    padding = "",
    full = "true",
} = Astro.props;

const isNoBottomMargin = noBottomMargin === true || noBottomMargin === "true";
const isFull = full === true || full === "true";

let finalClass = "";

finalClass += "card ";
finalClass += hover ? `hover-${hover} ` : ``;
finalClass += theme ? `theme-${theme} ` : ``;
finalClass += borderless === "true" || borderless === true ? `borderless ` : ``;
finalClass += !isNoBottomMargin ? `has-margin ` : ``;
finalClass += padding ? `padding-${padding} ` : ``;
finalClass += isFull ? `full ` : ` `;
---

<div class={finalClass}>
    <div class="card-content">
        <slot />
    </div>
</div>

<style>
    .card {
        --bg-color-default: var(--bg-surface);
        --bg-color-border: var(--border-color);
        --text-color-default: var(--text-primary);
        --bg-color-hover: var(--bg-alt);
        --text-color-hover: inherit;

        color: var(--text-color-default);
        background-color: var(--bg-color-default);
        border: 1px solid var(--bg-color-border);
        padding: var(--spacing-md);
        border-radius: var(--border-radius);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        width: 100%;
        height: fit-content;

        transform: translateY(0px);
        transition: all 0.2s ease-in-out;
    }

    /* Ensure slotted elements inherit changing colors properly */
    .card-content :global(*):not(h1, h2, h3, h4, h5, h6, a) {
        color: inherit;
    }

    div.has-margin {
        margin-top: var(--spacing-md);
        margin-bottom: var(--spacing-md);
    }

    div.padding-more {
        padding-top: var(--spacing-lg);
        padding-bottom: var(--spacing-lg);
    }

    div.padding-none {
        padding-top: 0;
        padding-bottom: 0;
    }

    div.padding-bottom {
        padding-top: 0;
    }

    div.theme-dark {
        --bg-color-default: var(--text-primary);
        --bg-color-border: var(--border-color);
        --text-color-default: var(--bg-primary);
        --bg-color-hover: var(--text-muted);
        --text-color-hover: var(--bg-primary);
    }

    div.theme-border {
        --bg-color-default: transparent;
        --bg-color-border: var(--border-color);
        --text-color-default: inherit;
        --bg-color-hover: var(--bg-surface);
        --text-color-hover: inherit;
    }

    div.theme-middle {
        --bg-color-default: var(--bg-alt);
        --bg-color-border: var(--border-color);
        --text-color-default: inherit;
        --bg-color-hover: var(--theme-primary);
        --text-color-hover: var(--bg-primary);
    }
    div.theme-bold {
        --bg-color-default: var(--theme-primary);
        --bg-color-border: var(--border-color);
        --text-color-default: var(--bg-primary);
        --bg-color-hover: var(--bg-alt);
        --text-color-hover: inherit;
    }

    div.borderless {
        border: 0;
    }

    div.hover-move:hover {
        transform: translateY(-4px);
    }

    div.hover-color:hover {
        background-color: var(--bg-color-hover);
        color: var(--text-color-hover);
    }

    div.hover-both:hover {
        transform: translateY(-4px);
        box-shadow: 4px 10px 24px rgba(0, 0, 0, 0.35);
        background-color: var(--bg-color-hover);
        color: var(--text-color-hover);
    }

    div.full {
        height: 100%;
    }
</style>
