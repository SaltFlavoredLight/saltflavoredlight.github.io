---
import "../../styles/main.css";
import "../../styles/themes.css";

import Card from "./Card.astro";

interface Props {
    title: string;
    href?: string;
    noBottomMargin?: boolean | "true" | "false";

    /** when blank, disabled, otherwise, the name appeared here will be applied to style, Option: color, move, both */
    hover?: "" | "color" | "move" | "both";

    /** this is theme for the card, default is light, where also have Dark, Border and Middle option */
    theme?: "" | "dark" | "border" | "middle" | "bold";

    /** true if you hate border */
    borderless?: Boolean | "true" | "false";

    /** other way to enter is just use Slots */
    content?: string;
}

const {
    title,
    href = "#",
    noBottomMargin = "false",
    hover = "both",
    theme = "border",
    borderless = false,
    content = "",
} = Astro.props;

const isNoBottomMargin = noBottomMargin === true || noBottomMargin === "true";

let finalClass = "";

finalClass += "link-card ";
finalClass += !isNoBottomMargin ? "has-margin " : "";
finalClass += theme ? `theme-${theme}` : "";
---

<a class={finalClass} href={href}>
    <Card noBottomMargin hover={hover} theme={theme} borderless={borderless}>
        {
            title && title.trim() !== "" && (
                <h3>
                    {title}
                    <span> &rarr;</span>
                </h3>
            )
        }
        {content}
        <slot />
    </Card>
</a>

<style>
    .link-card {
        display: block;
        width: 100%;
        text-decoration: none;
        color: unset;

        margin-top: var(--spacing-xs);
        margin-bottom: none;
    }

    .link-card h3,
    .link-card.theme-bold:hover h3 {
        margin: 0;
        color: var(--theme-primary);
    }

    .link-card.theme-middle:hover h3,
    .link-card.theme-bold h3 {
        color: var(--bg-light);
    }

    .link-card.theme-middle:hover p,
    .link-card.theme-bold p {
        color: var(--bg-surface);
    }

    .link-card.has-margin {
        margin-top: var(--spacing-xs);
        margin-bottom: var(--spacing-md);
    }
</style>
