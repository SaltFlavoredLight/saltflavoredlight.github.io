---
import type { HTMLAttributes } from 'astro/types';

// Extend HTMLAttributes for both anchor and button elements
interface Props extends HTMLAttributes<'button'>, HTMLAttributes<'a'> {
    /** (optional) The destination URL. If provided, renders as an <a> tag. */
    href?: string;

    /** (optional) The button's style format: general, fill, border, text, or bg */
    format?: string;
}

import "#src/styles/main.css";
import "#src/styles/themes.css";

const { href, format = "fill", class: className, ...attrs } = Astro.props;

const finalStyle = `btn-${format} ${className || ''}`.trim();
---

{href ? (
    <a href={href} class={finalStyle} {...attrs}>
        <slot />
    </a>
) : (
    <button class={finalStyle} {...attrs}>
        <slot />
    </button>
)}

<style>
    .btn-general {
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-general:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }

    /* Style 1: Fill Color Button */
    .btn-fill {
        background-color: var(--theme-primary);
        color: #ffffff;
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-fill:hover {
        background-color: var(--theme-light);
        border-color: var(--theme-light);
    }

    /* Style 2: Border Button */
    .btn-border {
        background-color: transparent;
        color: var(--text-primary);
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-border:hover {
        background-color: var(--theme-primary);
        color: #ffffff;
        border-color: var(--theme-primary);
    }

    /* Style 3: Text-Only Button */
    .btn-text {
        background-color: transparent;
        color: var(--theme-primary);
        font-weight: 600;
        border: 2px solid transparent;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-text:hover {
        background-color: var(--bg-alt);
        color: var(--theme-light);
        text-decoration: underline;
    }

    .btn-bg {
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: 0 var(--spacing-xs);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius, 4px);
        transition: all var(--transition-speed);
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-bg:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }
</style>
