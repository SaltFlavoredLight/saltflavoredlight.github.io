---
import type { HTMLAttributes } from 'astro/types';

// Extend HTMLAttributes for both anchor and button elements
interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'> {
    /** (optional) The destination URL. If provided, renders as an <a> tag. */
    href?: string;

    /** (optional) The button's style format: general, fill, border, text, or bg */
    format?: string;

    jsid?: string;

    noBottomMargin?: boolean | "true" | "false";
}

import "#src/styles/main.css";
import "#src/styles/themes.css";

const { href, format = "fill", jsid, noBottomMargin = true } = Astro.props;

const isNoBottomMargin = noBottomMargin === true || noBottomMargin === "true";

const finalStyle =
    `btn-${format}` + (isNoBottomMargin ? " no-bottom-margin" : "");
---

{href ? (
    <a href={href} class={finalStyle} id={jsid}>
        <slot />
    </a>
) : (
    <button class={finalStyle} id={jsid}>
        <slot />
    </button>
)}

<style>
    .btn-general {
        font-size: unset;
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
        margin-bottom: var(--spacing-xs);
    }

    .btn-general:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }

    /* Style 1: Fill Color Button */
    .btn-fill {
        font-size: unset;
        background-color: var(--theme-primary);
        color: #ffffff;
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
        margin-bottom: var(--spacing-xs);
    }

    .btn-fill:hover {
        background-color: var(--theme-light);
        border-color: var(--theme-light);
    }

    /* Style 2: Border Button */
    .btn-border {
        font-size: unset;
        background-color: transparent;
        color: var(--text-primary);
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
        margin-bottom: var(--spacing-xs);
    }

    .btn-border:hover {
        background-color: var(--theme-primary);
        color: #ffffff;
        border-color: var(--theme-primary);
    }

    /* Style 3: Text-Only Button */
    .btn-text {
        font-size: unset;
        background-color: transparent;
        color: var(--theme-primary);
        font-weight: 600;
        border: 2px solid transparent;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
        margin-bottom: var(--spacing-xs);
    }

    .btn-text:hover {
        background-color: var(--bg-alt);
        color: var(--theme-light);
        text-decoration: underline;
    }

    .btn-bg {
        font-size: unset;
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: 0 var(--spacing-xs);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius, 4px);
        transition: all var(--transition-speed);
        text-decoration: none;
        white-space: nowrap;
        margin-bottom: var(--spacing-xs);
    }

    .btn-bg:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }

    .no-bottom-margin {
        margin-bottom: 0px;
    }
</style>
