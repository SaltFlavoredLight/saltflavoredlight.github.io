---
interface Props {
    /** The main title displayed at the top of the card */
    href: string;

    /** (optional) what's the button's style? Support general, fill, border, text and bg */
    format?: string;
}

import "../../styles/main.css";
import "../../styles/themes.css";
import "../../styles/core.css";

const { href = "/", format = "fill" } = Astro.props;

const finalStyle = `btn-${format}`;
---

<a href={href} class={finalStyle}>
    <slot />
</a>

<style>
    .btn-general {
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-general:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }

    /* Style 1: Fill Color Button */
    .btn-fill {
        background-color: var(--theme-primary);
        color: #ffffff;
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-fill:hover {
        background-color: var(--theme-light);
        border-color: var(--theme-light);
    }

    /* Style 2: Border Button */
    .btn-border {
        background-color: transparent;
        color: var(--text-primary);
        font-weight: 600;
        border: 2px solid var(--theme-primary);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-border:hover {
        background-color: var(--theme-primary);
        color: #ffffff;
        border-color: var(--theme-primary);
    }

    /* Style 3: Text-Only Button */
    .btn-text {
        background-color: transparent;
        color: var(--theme-primary);
        font-weight: 600;
        border: 2px solid transparent;
        padding: var(--spacing-xs) var(--spacing-sm);
        font-family: var(--font-primary);
        cursor: pointer;
        border-radius: var(--border-radius);
        transition: all var(--transition-speed);
        text-decoration: none;
    }

    .btn-text:hover {
        background-color: var(--bg-alt);
        color: var(--theme-light);
        text-decoration: underline;
    }

    .btn-bg {
        background-color: transparent;
        color: inherit;
        font-weight: 600;
        border: 2px solid currentColor;
        padding: 0 var(--spacing-xs);
        font-family: inherit;
        cursor: pointer;
        border-radius: var(--border-radius, 4px);
        transition: all var(--transition-speed);
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-bg:hover {
        color: var(--text-primary);
        background-color: var(--bg-primary);
        border: 2px solid var(--bg-primary);
    }
</style>
