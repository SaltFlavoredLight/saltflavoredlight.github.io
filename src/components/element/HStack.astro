---
interface Props {
    /** Gap spacing option between items */
    gap?: "" | "none" | "xs" | "sm" | "md" | "lg" | "xg";

    /** Layout mode: Flex row (space-between) or Grid */
    mode?: "flex" | "grid";

    /** Force 100% width across the container */
    fullWidth?: boolean;

    noBottomMargin?: boolean | "false" | "true";
}

const {
    gap = "md",
    mode = "grid",
    noBottomMargin = false,
    fullWidth = false,
} = Astro.props;

const isNoBottomMargin = (noBottomMargin === true || noBottomMargin === "true");

// Clean class builder
const className = [
    "layout-row",
    gap ? `gap-${gap}` : "",
    `mode-${mode}`,
    fullWidth ? "full-width" : "",
    !isNoBottomMargin ? `has-margin` : ` `
]
    .filter(Boolean)
    .join(" ");
---

<div class={className}>
    <slot />
</div>

<style>
    .layout-row {
        box-sizing: border-box;
        width: 100%;
    }

    /* Gap options mapped to theme variables */
    .layout-row.gap-none {
        gap: 0;
    }
    .layout-row.gap-xs {
        gap: var(--spacing-xs, 0.25rem);
    }
    .layout-row.gap-sm {
        gap: var(--spacing-sm, 0.5rem);
    }
    .layout-row.gap-md {
        gap: var(--spacing-md, 1rem);
    }
    .layout-row.gap-lg {
        gap: var(--spacing-lg, 1.5rem);
    }
    .layout-row.gap-xg {
        gap: var(--spacing-xg, 2rem);
    }

    /* 1. Flex Mode (Row with space-between) */
    .layout-row.mode-flex {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    /* 2. Grid Mode */
    .layout-row.mode-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    /* Force Full Width Modifier */
    .layout-row.full-width {
        width: 100% !important;
        max-width: none !important;
    }

    @media (max-width: 600px) {
        .layout-row.mode-flex,
        .layout-row.mode-grid {
            display: flex;
            flex-direction: column;
            flex-wrap: nowrap;
            gap: 0;
        }
    }

    .layout-row.has-margin {
        margin-top: var(--spacing-md);
        margin-bottom: var(--spacing-md);
    }
</style>
