---
import "#src/styles/main.css";
import "#src/styles/themes.css";


import { siteConfig } from '#config/siteConfig.js';


const footerMap = siteConfig.footerMap;
---

<div class="site-links">
    {
        footerMap.map((item) => (
            <div>
                <h3>{item.name}</h3>
                <ul>
                    {item.lists.map((labels) => (
                        <li>
                            <a href={labels.href}>{labels.name}</a>
                        </li>
                    ))}
                </ul>
            </div>
        ))
    }
</div>

<style>
    a {
        background: var(--theme-primary);
        color: var(--bg-primary);
        margin: 0;
        font: inherit;
        text-decoration: none;
    }

    a:hover {
        color: var(--text-primary);
    }

    p,
    h2,
    h1,
    h3,
    li,
    ul,
    ol {
        background: var(--theme-primary);
        color: var(--bg-primary);
        margin: 0;
        padding: 0;
    }

    h3 {
        font-size: 1.2em;
    }

    .site-links {
        display: flex;
        flex-direction: row;
        gap: var(--spacing-md);
        text-align: right;
        flex-wrap: wrap;
    }

    .site-links ul {
        width: 100%;
        min-width: 150px;
    }

    @media (max-width: 800px) {
        .site-links {
            text-align: center;
            gap: var(--spacing-xs);
        }

        .site-links ul {
            width: 50%;
        }
    }
</style>
