---
import "#src/styles/main.css";
import "#src/styles/themes.css";


import { siteConfig } from '#config/siteConfig.js';

import logo from "#assets/logo.png";
import { Image } from "astro:assets";
import HomeButton from "#components/site/HomeButtons.astro";
---

<div class="site-info">
    <a class="profile-link" href="/">
        <Image alt="Ray's Avatar" src={logo} class="avatar" />
        <h2>{siteConfig.footerTitle}</h2>
        <p>{siteConfig.aboutMessageShort}</p>
    </a>
    <hr>
    <HomeButton />
</div>

<style>
    .site-info {
        width: 100%;
        max-width: 550px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        background: var(--theme-primary);
    }

    .profile-link {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        background: var(--theme-primary);
        color: var(--bg-primary);
        margin: 0;
        font: inherit;
        text-decoration: none;
    }

    .profile-link:hover,
    .profile-link:hover h2,
    .profile-link:hover p {
        color: var(--text-primary);
    }

    p,
    h2 {
        background: var(--theme-primary);
        color: var(--bg-primary);
        margin: 0;
        padding: 0;
    }

    hr {
        width: 100%;
        background-color: var(--bg-primary);
        opacity: 0.35;
        margin: var(--spacing-sm) 0;
    }

    .avatar {
        height: 150px;
        width: 150px;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: var(--spacing-sm);
    }


    
    @media (max-width: 800px) {
        .site-info,
        .profile-link {
            align-items: center;
            text-align: center;
        }
    }
</style>
