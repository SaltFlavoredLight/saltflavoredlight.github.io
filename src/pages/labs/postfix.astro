---
import "#src/styles/main.css";
import "#src/styles/themes.css";

import PageLayout from "#src/layouts/PageLayout.astro";
import Section from "#src/components/Section.astro";
import Card from "#src/components/element/Card.astro";
import Group from "#src/components/element/Group.astro";
import Button from "#src/components/element/Button.astro";
import YouTube from "#src/components/element/YouTube.astro";
import CardLink from "#src/components/element/CardLink.astro";
import HStack from "#src/components/element/HStack.astro";
import C169 from "#src/components/C169.astro";
import Figure from "#src/components/element/Figure.astro";

import codeImage from "#src/assets/code.png";

const description =
    "A Website About Ray. Hi! This is Ray and I love to share something! you are welcome to my website!";
---

<PageLayout title="Lab: how we calculate Post Fix" description={description} slug="/">


    <input type="text" id="tokenInput"><br>
    <div>
    
    <label for="checkReverse"><input type="radio" id="checkReverse" name="whichOne">Prefix Form</label> 
    <label for="checkNotReverse"><input type="radio" id="checkNotReverse" checked name="whichOne">Postfix Form</label>
    
    </div><br>
    <button id="startButton">Start</button>
    <p> Make sure you enter space between each token! like "3 3 +" not "33+"</p>

    <hr>
    
    <div class="stackThinking" id="stack">
        <div> 1 </div>
    </div>

    <br> 

    <table id="table">
        <tr>
            <th> Token </th>
            <th> Calculation Needed </th>
            <th> Snapshot of the Stack </th>
        </tr>
    </table>

    <hr>
    
    <p> Created by Ray Z, a Magnet Student. @saltflavoredlight</p>    

    <script>
        const input = document.getElementById("tokenInput");
        const table = document.getElementById("table");
        const stackListElement = document.getElementById("stack");
        const checkReverse = document.getElementById("checkReverse");
        let tokenList = [];
        let stackInstance;

        class stackGroup {
            constructor(stackListElement) {
                if (!(stackListElement instanceof HTMLElement)) {
                    throw new Error("stackListElement must be a valid DOM element");
                }
                this.stack = [];
                this.stackList = stackListElement;
            }

            pop() {
                if (this.stack.length === 0) {
                    console.warn("Stack is empty. Nothing to pop.");
                    return null;
                }
                const result = this.stack.pop();
                this.updateHTML();
                return result;
            }

            push(token) {
                this.stack.push(token);
                this.updateHTML();
            }

            updateHTML() {
                // Clear the list
                this.stackList.innerHTML = "";
                // Rebuild stack display
                this.stack.forEach((value) => {
                    const newDiv = document.createElement("div");
                    newDiv.textContent = value; // safer than innerHTML
                    this.stackList.appendChild(newDiv);
                });
            }
        }


        function init() {
            stackInstance = new stackGroup(stackListElement);

            table.innerHTML = `
            <tr>
                <th> Token </th>
                <th> Snapshot of the Stack </th>
            </tr>`

            stackListElement.innerHTML = ``;
            tokenList = input.value.split(" ");

            if (checkReverse.checked === true) {
                tokenList = tokenList.toReversed();
            }

            console.log(tokenList);
        };

        function calculateEachStep () {

            // step 1: read the first token I know.
            if (tokenList.length === 0) {
                return;
            }

            let token = tokenList.shift();
            
            let a;
            let b;

            // step 2: is that a operator or a operends?
            if (token === "+"){
                if (checkReverse.checked === true) {
                    a = stackInstance.pop();
                    b = stackInstance.pop();
                } else {
                	b = stackInstance.pop();
                	a = stackInstance.pop();
                }
                stackInstance.push(a + b);

            } else if (token === "-"){
                if (checkReverse.checked === true) {
                    a = stackInstance.pop();
                    b = stackInstance.pop();
                } else {
                	b = stackInstance.pop();
                	a = stackInstance.pop();
                }
                stackInstance.push(a - b);

            } else if (token === "^"){
                if (checkReverse.checked === true) {
                    a = stackInstance.pop();
                    b = stackInstance.pop();
                } else {
                	b = stackInstance.pop();
                	a = stackInstance.pop();
                }
                stackInstance.push(a ^ b);

            } else if (token === "*"){
                if (checkReverse.checked === true) {
                    a = stackInstance.pop();
                    b = stackInstance.pop();
                } else {
                	b = stackInstance.pop();
                	a = stackInstance.pop();
                }
                stackInstance.push(a * b);

            } else if (token === "/"){
                if (checkReverse.checked === true) {
                    a = stackInstance.pop();
                    b = stackInstance.pop();
                } else {
                	b = stackInstance.pop();
                	a = stackInstance.pop();
                }
                stackInstance.push(a / b);
            } else {
                stackInstance.push(parseInt(token))
            }


            // step 0: forgot last one log, log first!
            let snapshot = stackInstance.stack;
            
            //pop + push again

            const newLog = document.createElement("tr");
            newLog.innerHTML = `
                <th> ${token} </th>
                <th> ${JSON.stringify(snapshot.toReversed())} </th>
            `;
            table.appendChild(newLog);            

            // popup the last 2, if it's not operends I will add it back.
            console.log(token)

            setTimeout(calculateEachStep, 1000);
                
        };

        function startCalculation() {
            init();
            calculateEachStep();
        };

        document.getElementById("startButton").addEventListener("click", startCalculation);
    </script>
</BaseLayout>



    <style>        
        .stackThinking {
            display: flex;
            flex-wrap: wrap;
            flex-direction: row-reverse;
            justify-content: flex-end;
            border: 1px solid #212121;
            width: 600px;
        }

        .stackThinking div {
            display: flex;
            align-items: center;
            text-align: center;
            border-right: 1px solid #212121;
            height: 50px;
            min-width: 50px;
            justify-content: center;
            font-size: 25px;
        }
    </style>  


