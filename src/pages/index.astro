---
import "../styles/main.css";
import "../styles/themes.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Card from "../components/element/Card.astro";
import Group from "../components/element/Group.astro";
import Button from "../components/element/Button.astro";
import YouTube from "../components/element/YouTube.astro";
import CardLink from "../components/element/CardLink.astro";
import HStack from "../components/element/HStack.astro";

const description =
    "A Website About Ray. Hi! This is Ray and I love to share something! you are welcome to my website!";
---

<BaseLayout title="Welcome!" description={description} slug="/">
    <!-- Title -->
    <h1 class="text-center">
        <span class="hide-on-mobile" role="img" aria-label="Waving hand">👋</span>
        Hi there, <br class="show-on-mobile"> My name is Ray.
        <span class="hide-on-mobile" role="img" aria-label="Speech bubble">💬</span>
    </h1>
    <p class="text-center">
        <strong>A website that talks all About Me</strong>
    </p>

    <br>

    <!-- Features -->
    <HStack> 
        <CardLink noBottomMargin="true" title="Math Quiz" theme="">
            <p><strong>Test your Math?</strong> start with speedy quiz!</p>
            <p>Test how much your brain can do when dealing with lots of numbers.</p>
        </CardLink>
        <CardLink noBottomMargin="true" title="Math Quiz" theme="">
            <strong>See what project I am doing</strong>
        </CardLink>
    </HStack>
    <HStack> 
        <CardLink noBottomMargin="true" title="YouTUbe" theme="/youtube">
            <strong>About My Youtube</strong>
        </CardLink>
    </HStack>
    <hr />

    <!-- About Me -->
    <Section>
        <p>Hi! this is Ray.</p>

    </Section>
    <hr />

    <!-- Contact -->
    <p>Want to Reach out to Me? <a href="/contact">Visit Here.</a></p>
</BaseLayout>

<style>

        }
    }
</style>
