---
import "../styles/main.css";
import "../styles/themes.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Card from "../components/element/Card.astro";
import Group from "../components/element/Group.astro";
import Button from "../components/element/Button.astro";
import YouTube from "../components/element/YouTube.astro";
import CardLink from "../components/element/CardLink.astro";
import HStack from "../components/element/HStack.astro";
import C169 from "../components/C169.astro";
import Figure from "../components/element/Figure.astro";

import codeImage from "../assets/code.png";

const description =
    "A Website About Ray. Hi! This is Ray and I love to share something! you are welcome to my website!";
---

<BaseLayout title="Welcome!" description={description} slug="/">
    <!-- Title -->
    <h1 class="text-center">
        <span class="hide-on-mobile" role="img" aria-label="Waving hand"
            >👋</span
        >
        Hi there, <br class="show-on-mobile" /> My name is Ray.
        <span class="hide-on-mobile" role="img" aria-label="Speech bubble"
            >💬</span
        >
    </h1>
    <p class="text-center">
        <strong>A website that talks all About Me</strong>
    </p>
    
    <hr />

    <!-- Features -->
    <HStack>
        <CardLink
            noBottomMargin="true"
            title="Math Quiz"
            href="/math"
            theme="middle"
        >
            <p><strong>Test your Math?</strong> start with speedy quiz!</p>
            <p>
                Test how much your brain can do when dealing with lots of
                numbers.
            </p>
        </CardLink>
        <CardLink
            noBottomMargin="true"
            title="Projects"
            href="/projects"
            theme="middle"
        >
            <p><strong>See All My Projects here</strong>.</p>
            <p>Built fun, or big stuff, that benefit everyone</p>
        </CardLink>
    </HStack>
    <HStack>
        <CardLink
            noBottomMargin="true"
            title="YouTube"
            href="/youtube"
            theme="middle"
        >
            <p>
                <strong>Composing Musics, and share Tech thing</strong>.
                Original Scores let you walk though arts of sound.
            </p>
        </CardLink>
    </HStack>
    <p>Or, <a href="/sitemap">click here</a> to visit This Sitemap</p>

    <br />

    <Section theme="middle" margin="bottom">
        <h2>Working on Software......</h2>
        <p>I make tools, system, and also large web project!</p>
        <p>
            I using Astro as my static framework, and also my custom tools for
            Apps
        </p>
        <p>Stay Tuned becuase I am gonna release many thing!</p>

        <Figure
            src={codeImage}
            alt="A code snippet showing the Astro component markup."
            enableFootNote="left"
            radius="lg"
        />

        <Button href="/projects"> Learn More on this Project Planning </Button>
    </Section>

    <!-- About Me -->
    <h2>About Me</h2>
    <p>
        <strong>Hi! this is Ray.</strong> I love Math, Computer Science and Arts.
        And devaloper of web projects.
    </p>
    <p>
        I am dedicated to developing technology that allows everyone to benefit
        from the power of the Web and the Internet.
    </p>
    <p>
        About my Personal Life, I am deeply being converted to a Christian (by
        some reason that I even don't know).
    </p>

    <Group>
        <Button href="/about">Learn more about Me</Button>
        <Button href="/about/faith" format="border">Learn about my Faith</Button
        >
    </Group>

    <!-- Contact -->
    <hr />
    <p>Want to Reach out to Me? <a href="/contact">Visit Here.</a></p>
    <small>
        This Website is Built by Ray with Astro, Copyrigh (C) 2026 Ray.
    </small>
</BaseLayout>

<style>
    .text-center {
        text-align: center;
    }

    @media (min-width: 800px) {
        h1 {
            font-size: calc(var(--spacing-lg) * 1.2);
        }
    }
</style>
